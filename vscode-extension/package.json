{
  "name": "llm-logparser-analyzer",
  "displayName": "LLM LogParser Analysis Instrument",
  "description": "Hardcore utility wrapper and Liquid dashboard for llm-logparser",
  "version": "1.0.0",
  "publisher": "llm-logparser",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmLogparser.openDashboard",
        "title": "Open LogParser Instrument"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmLogparserExplorer",
          "title": "LLM LogParser",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "llmLogparserExplorer": [
        {
          "type": "webview",
          "id": "llmLogparser.sidebarView",
          "name": "Command Center",
          "icon": "resources/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "rm -rf dist && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "test": "echo 'No tests yet'"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  }
}
