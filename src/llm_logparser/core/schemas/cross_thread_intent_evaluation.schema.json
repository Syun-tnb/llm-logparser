{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/cross_thread_intent_evaluation.schema.json",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "provider_id",
    "source_conversation_id",
    "target_conversation_id",
    "source_topic_id",
    "target_topic_id",
    "source_span_id",
    "target_span_id",
    "source_message_ids",
    "target_message_ids",
    "source_excerpt",
    "target_excerpt",
    "candidate_score",
    "candidate_rank",
    "candidate_reason_codes",
    "candidate_timestamp_delta_ms",
    "candidate_volume_gap",
    "candidate_temporal_gap_seconds",
    "candidate_continuity_mask",
    "candidate_dormancy_score",
    "candidate_specificity_score",
    "candidate_local_context_delta",
    "same_intent",
    "recall_type",
    "confidence",
    "reason"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "cross_thread_intent_evaluation" },
    "schema_version": { "type": "string", "const": "0.3" },
    "provider_id": { "type": "string", "minLength": 1 },
    "source_conversation_id": { "type": "string", "minLength": 1 },
    "target_conversation_id": { "type": "string", "minLength": 1 },
    "source_topic_id": { "type": "string", "minLength": 1 },
    "target_topic_id": { "type": "string", "minLength": 1 },
    "source_span_id": { "type": "string", "minLength": 1 },
    "target_span_id": { "type": "string", "minLength": 1 },
    "source_message_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "target_message_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_excerpt": { "type": "string" },
    "target_excerpt": { "type": "string" },
    "source_topic_label": { "type": ["string", "null"] },
    "target_topic_label": { "type": ["string", "null"] },
    "candidate_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_rank": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidate_embedding_similarity": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "candidate_timestamp_delta_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "candidate_volume_gap": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "candidate_temporal_gap_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "candidate_continuity_mask": { "type": "boolean" },
    "candidate_dormancy_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_specificity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_local_context_delta": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "same_intent": {
      "type": "string",
      "enum": ["yes", "no"]
    },
    "recall_type": {
      "type": "string",
      "enum": ["continuity", "recurrence"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
