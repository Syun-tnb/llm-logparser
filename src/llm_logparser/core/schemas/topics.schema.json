{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/topics.schema.json",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "provider_id",
    "topic_count",
    "generated_at",
    "source_inputs",
    "provenance",
    "topics"
  ],
  "properties": {
    "artifact_type": { "type": "string", "const": "semantic_topics" },
    "schema_version": { "type": "string", "const": "2.2" },
    "provider_id": { "type": "string", "minLength": 1 },
    "topic_count": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_inputs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/topicRecord" }
    }
  },
  "$defs": {
    "windowRef": {
      "type": "object",
      "required": ["conversation_id", "window_id"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "messageRef": {
      "type": "object",
      "required": ["conversation_id", "message_id"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "spanRef": {
      "type": "object",
      "required": [
        "conversation_id",
        "span_id",
        "message_ids",
        "state",
        "state_confidence",
        "state_signals"
      ],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "state": {
          "type": "string",
          "enum": ["unresolved", "in_progress", "done"]
        },
        "state_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "state_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "window_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "representativeWindow": {
      "type": "object",
      "required": ["conversation_id", "window_id", "excerpt"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "representativeSpan": {
      "type": "object",
      "required": [
        "conversation_id",
        "span_id",
        "message_ids",
        "excerpt",
        "state",
        "state_confidence",
        "state_signals"
      ],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excerpt": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["unresolved", "in_progress", "done"]
        },
        "state_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "state_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "window_id": { "type": "string", "minLength": 1 },
        "source_window_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "refinement": { "$ref": "#/$defs/representativeSpanRefinement" },
        "semantic_normalization": {
          "$ref": "#/$defs/semanticNormalization"
        }
      },
      "additionalProperties": false
    },
    "semanticNormalizationMethod": {
      "type": "object",
      "required": ["kind", "model", "mapping_version"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["llm", "rule", "hybrid"]
        },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "semanticNormalization": {
      "type": "object",
      "required": [
        "conversation_id",
        "span_id",
        "window_id",
        "message_ids",
        "unit_kind",
        "raw_label",
        "normalized_label",
        "mapping_status",
        "confidence",
        "method"
      ],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": ["string", "null"], "minLength": 1 },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unit_kind": {
          "type": "string",
          "const": "representative_span"
        },
        "raw_label": { "type": "string", "minLength": 1 },
        "normalized_label": {
          "type": ["string", "null"],
          "enum": [
            "proposal",
            "request",
            "agreement",
            "disagreement",
            "decision",
            "clarification",
            "question",
            "step_transition",
            "status_update",
            "reflection",
            null
          ]
        },
        "mapping_status": {
          "type": "string",
          "enum": ["mapped", "needs_review", "taxonomy_gap", "unmapped"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "method": { "$ref": "#/$defs/semanticNormalizationMethod" }
      },
      "additionalProperties": false
    },
    "normalizationPromptProvenance": {
      "type": "object",
      "required": ["raw_label_prompt_sha1", "mapping_prompt_sha1"],
      "properties": {
        "raw_label_prompt_sha1": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "mapping_prompt_sha1": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "normalizationProvenance": {
      "type": "object",
      "required": [
        "source_kind",
        "job_id",
        "model",
        "taxonomy_version",
        "prompt_provenance",
        "matched_representative_span_count",
        "unmatched_representative_span_count",
        "drifted_representative_span_count"
      ],
      "properties": {
        "source_kind": { "type": "string", "const": "batch" },
        "job_id": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "taxonomy_version": { "type": ["string", "null"], "minLength": 1 },
        "prompt_provenance": {
          "$ref": "#/$defs/normalizationPromptProvenance"
        },
        "matched_representative_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_representative_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "drifted_representative_span_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "representativeSpanRefinement": {
      "type": "object",
      "required": ["source_kind", "proposal_kind", "reason_code"],
      "properties": {
        "source_kind": {
          "type": "string",
          "const": "semantic_span_proposals"
        },
        "proposal_kind": {
          "type": "string",
          "enum": ["split", "merge"]
        },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "representativeSpanRefinementProvenance": {
      "type": "object",
      "required": [
        "source_kind",
        "artifact_path",
        "proposal_count",
        "refined_representative_span_count",
        "unchanged_representative_span_count",
        "ambiguous_representative_span_count",
        "drifted_representative_span_count"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "const": "semantic_span_proposals"
        },
        "artifact_path": { "type": "string", "minLength": 1 },
        "proposal_count": { "type": "integer", "minimum": 0 },
        "refined_representative_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged_representative_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_representative_span_count": {
          "type": "integer",
          "minimum": 0
        },
        "drifted_representative_span_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "qualitySignals": {
      "type": "object",
      "required": [
        "cluster_size",
        "conversation_count",
        "avg_intra_cluster_score",
        "max_intra_cluster_score",
        "single_window"
      ],
      "properties": {
        "cluster_size": { "type": "integer", "minimum": 1 },
        "conversation_count": { "type": "integer", "minimum": 1 },
        "avg_intra_cluster_score": { "type": ["number", "null"] },
        "max_intra_cluster_score": { "type": ["number", "null"] },
        "single_window": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "clusteringProvenance": {
      "type": "object",
      "required": [
        "method",
        "edge_policy",
        "neighbor_k",
        "score_threshold_policy"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "edge_policy": { "type": "string", "minLength": 1 },
        "neighbor_k": { "type": ["integer", "null"], "minimum": 0 },
        "score_threshold_policy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "required": ["cluster_id", "min_cluster_size", "cross_thread_only"],
      "properties": {
        "cluster_id": { "type": ["string", "null"] },
        "min_cluster_size": { "type": "integer", "minimum": 1 },
        "cross_thread_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "pipeline_version",
        "membership_mode",
        "label_mode",
        "embedding_model",
        "labeling_model",
        "prompt_hash",
        "prompt_variant",
        "window_cap",
        "max_window_chars",
        "clustering",
        "filters"
      ],
      "properties": {
        "pipeline_version": { "type": "string", "minLength": 1 },
        "membership_mode": { "type": "string", "const": "span-and-message-v2" },
        "label_mode": {
          "type": "string",
          "enum": ["structural-only", "model-enriched"]
        },
        "embedding_model": { "type": ["string", "null"] },
        "labeling_model": { "type": ["string", "null"] },
        "prompt_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prompt_variant": { "type": ["string", "null"], "minLength": 1 },
        "window_cap": { "type": "integer", "minimum": 1 },
        "max_window_chars": { "type": "integer", "minimum": 1 },
        "clustering": { "$ref": "#/$defs/clusteringProvenance" },
        "filters": { "$ref": "#/$defs/filters" },
        "normalization": { "$ref": "#/$defs/normalizationProvenance" },
        "representative_span_refinement": {
          "$ref": "#/$defs/representativeSpanRefinementProvenance"
        }
      },
      "additionalProperties": false
    },
    "topicRecord": {
      "type": "object",
      "required": [
        "topic_id",
        "provider_id",
        "label",
        "summary",
        "keywords",
        "confidence",
        "state",
        "state_confidence",
        "cluster_ids",
        "conversation_ids",
        "span_refs",
        "message_refs",
        "cluster_count",
        "span_count",
        "window_count",
        "message_count",
        "first_seen",
        "last_seen",
        "representative_spans"
      ],
      "properties": {
        "topic_id": { "type": "string", "minLength": 1 },
        "provider_id": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "state": {
          "type": "string",
          "enum": ["unresolved", "in_progress", "done"]
        },
        "state_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cluster_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "conversation_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "span_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/spanRef" }
        },
        "message_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/messageRef" }
        },
        "cluster_count": { "type": "integer", "minimum": 1 },
        "span_count": { "type": "integer", "minimum": 1 },
        "window_count": { "type": "integer", "minimum": 1 },
        "message_count": { "type": "integer", "minimum": 1 },
        "quality_signals": { "$ref": "#/$defs/qualitySignals" },
        "first_seen": { "type": ["integer", "null"], "minimum": 0 },
        "last_seen": { "type": ["integer", "null"], "minimum": 0 },
        "representative_spans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/representativeSpan" }
        },
        "window_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/windowRef" }
        },
        "representative_windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/representativeWindow" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
