{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/topics.schema.json",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "provider_id",
    "topic_count",
    "source_inputs",
    "generation",
    "topics"
  ],
  "properties": {
    "artifact_type": { "type": "string", "const": "semantic_topics" },
    "schema_version": { "type": "string", "const": "0.1" },
    "provider_id": { "type": "string", "minLength": 1 },
    "topic_count": { "type": "integer", "minimum": 0 },
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "generation": {
      "type": "object",
      "required": [
        "membership_mode",
        "label_mode",
        "prompt_variant",
        "window_cap",
        "max_window_chars",
        "model",
        "filters"
      ],
      "properties": {
        "membership_mode": { "type": "string", "const": "cluster-is-topic-v1" },
        "label_mode": {
          "type": "string",
          "enum": ["structural-only", "model-enriched"]
        },
        "prompt_variant": {
          "type": ["string", "null"]
        },
        "window_cap": { "type": "integer", "minimum": 1 },
        "max_window_chars": { "type": "integer", "minimum": 1 },
        "model": { "type": ["string", "null"] },
        "filters": {
          "type": "object",
          "required": ["cluster_id", "min_cluster_size", "cross_thread_only"],
          "properties": {
            "cluster_id": { "type": ["string", "null"] },
            "min_cluster_size": { "type": "integer", "minimum": 1 },
            "cross_thread_only": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/topicRecord" }
    }
  },
  "$defs": {
    "windowRef": {
      "type": "object",
      "required": ["conversation_id", "window_id"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "messageRef": {
      "type": "object",
      "required": ["conversation_id", "message_id"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "representativeWindow": {
      "type": "object",
      "required": ["conversation_id", "window_id", "excerpt"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "topicRecord": {
      "type": "object",
      "required": [
        "topic_id",
        "provider_id",
        "cluster_ids",
        "conversation_ids",
        "window_refs",
        "message_refs",
        "cluster_count",
        "window_count",
        "message_count",
        "first_seen",
        "last_seen",
        "label",
        "summary",
        "keywords",
        "confidence",
        "representative_windows"
      ],
      "properties": {
        "topic_id": { "type": "string", "minLength": 1 },
        "provider_id": { "type": "string", "minLength": 1 },
        "cluster_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "conversation_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "window_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/windowRef" }
        },
        "message_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/messageRef" }
        },
        "cluster_count": { "type": "integer", "minimum": 1 },
        "window_count": { "type": "integer", "minimum": 1 },
        "message_count": { "type": "integer", "minimum": 1 },
        "first_seen": { "type": ["integer", "null"], "minimum": 0 },
        "last_seen": { "type": ["integer", "null"], "minimum": 0 },
        "label": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "representative_windows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/representativeWindow" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
