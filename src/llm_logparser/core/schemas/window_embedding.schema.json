{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/window_embedding.schema.json",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "provider_id",
    "conversation_id",
    "window_id",
    "ts_start",
    "ts_end",
    "embedding_model",
    "embedding_dim",
    "text_char_count",
    "embedding"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "window_embedding" },
    "schema_version": { "type": "string", "const": "0.1" },
    "provider_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "window_id": { "type": "string", "minLength": 1 },
    "ts_start": { "$ref": "#/$defs/nonNegativeIntegerOrNull" },
    "ts_end": { "$ref": "#/$defs/nonNegativeIntegerOrNull" },
    "embedding_model": { "type": "string", "minLength": 1 },
    "embedding_dim": { "$ref": "#/$defs/positiveInteger" },
    "text_char_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "embedding": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nonNegativeIntegerOrNull": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
