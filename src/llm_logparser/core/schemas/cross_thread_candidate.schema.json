{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/cross_thread_candidate.schema.json",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "provider_id",
    "source_conversation_id",
    "target_conversation_id",
    "source_topic_id",
    "target_topic_id",
    "source_span_id",
    "target_span_id",
    "source_message_ids",
    "target_message_ids",
    "source_excerpt",
    "target_excerpt",
    "timestamp_delta_ms",
    "volume_gap",
    "temporal_gap_seconds",
    "continuity_mask",
    "dormancy_score",
    "specificity_score",
    "local_context_delta",
    "score",
    "rank",
    "evidence"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "cross_thread_candidate" },
    "schema_version": { "type": "string", "const": "0.3" },
    "provider_id": { "type": "string", "minLength": 1 },
    "source_conversation_id": { "type": "string", "minLength": 1 },
    "target_conversation_id": { "type": "string", "minLength": 1 },
    "source_topic_id": { "type": "string", "minLength": 1 },
    "target_topic_id": { "type": "string", "minLength": 1 },
    "source_span_id": { "type": "string", "minLength": 1 },
    "target_span_id": { "type": "string", "minLength": 1 },
    "source_message_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "target_message_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_excerpt": { "type": "string" },
    "target_excerpt": { "type": "string" },
    "source_topic_label": { "type": ["string", "null"] },
    "target_topic_label": { "type": ["string", "null"] },
    "source_normalized_label": { "type": ["string", "null"] },
    "target_normalized_label": { "type": ["string", "null"] },
    "source_raw_label": { "type": ["string", "null"] },
    "target_raw_label": { "type": ["string", "null"] },
    "timestamp_delta_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "volume_gap": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "temporal_gap_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "continuity_mask": { "type": "boolean" },
    "dormancy_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "specificity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "local_context_delta": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "embedding_similarity": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "type": "object",
      "required": [
        "reason_codes",
        "excerpt_similarity",
        "topic_label_similarity",
        "keyword_overlap_count",
        "shared_keywords",
        "normalized_label_match",
        "raw_label_match",
        "volume_gap",
        "temporal_gap_seconds",
        "continuity_mask",
        "dormancy_score",
        "specificity_score",
        "local_context_delta"
      ],
      "properties": {
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excerpt_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "topic_label_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keyword_overlap_count": {
          "type": "integer",
          "minimum": 0
        },
        "shared_keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "normalized_label_match": { "type": "boolean" },
        "raw_label_match": { "type": "boolean" },
        "volume_gap": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "temporal_gap_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "continuity_mask": { "type": "boolean" },
        "dormancy_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "specificity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "local_context_delta": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
