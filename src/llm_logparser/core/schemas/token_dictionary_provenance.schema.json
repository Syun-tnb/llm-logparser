{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/token_dictionary_provenance.schema.json",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "producer_layer",
    "provider_id",
    "created_at",
    "source_inputs",
    "reproducibility_note",
    "token_count",
    "bundle_count"
  ],
  "properties": {
    "artifact_type": { "const": "token_dictionary_provenance" },
    "schema_version": { "type": "string", "const": "0.1" },
    "producer_layer": { "type": "string", "const": "L3" },
    "provider_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reproducibility_note": { "type": "string", "minLength": 1 },
    "token_count": { "type": "integer", "minimum": 0 },
    "bundle_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
