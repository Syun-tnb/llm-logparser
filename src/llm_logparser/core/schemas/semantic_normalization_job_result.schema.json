{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/semantic_normalization_job_result.schema.json",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "job_id",
    "provider_id",
    "conversation_id",
    "span_id",
    "window_id",
    "message_ids",
    "text_sha1",
    "raw_label",
    "normalized_label",
    "mapping_status",
    "confidence",
    "method",
    "latency_ms",
    "completed_at"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "semantic_normalization_result" },
    "schema_version": { "type": "string", "const": "0.1" },
    "job_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": "string", "minLength": 1 },
    "window_id": { "type": "string", "minLength": 1 },
    "message_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "text_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "raw_label": { "type": "string", "minLength": 1 },
    "normalized_label": {
      "type": ["string", "null"],
      "enum": [
        "proposal",
        "request",
        "agreement",
        "disagreement",
        "decision",
        "clarification",
        "question",
        "step_transition",
        "status_update",
        "reflection",
        null
      ]
    },
    "mapping_status": {
      "type": "string",
      "enum": ["mapped", "needs_review", "taxonomy_gap", "unmapped"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "object",
      "required": ["kind", "model", "mapping_version"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["llm", "rule", "hybrid"]
        },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "latency_ms": { "type": "number", "minimum": 0 },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
